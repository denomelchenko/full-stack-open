# Copy this file to .env and fill in the real values.
# .env is gitignored; this file is committed and must never contain a secret.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/bloglist?retryWrites=true&w=majority
TEST_MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/bloglist_test?retryWrites=true&w=majority
PORT=3003
SECRET=<a long random string, for example the output of: openssl rand -hex 32>
