# Copy this file to .env and fill in the real values.
# .env is gitignored; this file is committed and must never contain a secret.
#
# Default for local development: MongoDB 7 in Docker (8.x will not start on
# Docker Desktop kernels 6.19+, SERVER-121912):
#   docker run -d --name fso-mongo -p 27017:27017 --restart unless-stopped mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/bloglist
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/bloglist_test
#
# Alternative: MongoDB Atlas, no Docker needed.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bloglist
# TEST_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bloglist_test
PORT=3003
SECRET=<generate-a-long-random-string>
